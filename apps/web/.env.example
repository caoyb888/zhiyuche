# 复制为 .env.local 使用（.env / .env.local 不要提交）
# 后端 API 前缀；dev 模式下 /api 由 vite proxy 转发到 VITE_DEV_PROXY_TARGET
VITE_API_BASE=/api/v1
# dev server 代理目标（仅 vite.config.ts 读取，缺省 http://localhost:20080）
VITE_DEV_PROXY_TARGET=http://localhost:20080
# WebSocket 地址
VITE_WS_URL=ws://localhost:20080/ws
# 高德地图 Web JS API Key
VITE_AMAP_KEY=
