# 复制为 .env.local 使用（.env / .env.local 不要提交）
# 后端 API 前缀；dev 模式下 /api 由 vite proxy 转发到 VITE_DEV_PROXY_TARGET
VITE_API_BASE=/api/v1
# dev server 代理目标（仅 vite.config.ts 读取，缺省 http://localhost:20080）
VITE_DEV_PROXY_TARGET=http://localhost:20080
# WebSocket 完整地址（如 ws://localhost:20080/api/v1/ws）；留空则按当前页面地址 + VITE_API_BASE + /ws 推导
# （dev 模式下 /api 的 WebSocket 同样由 vite proxy 转发）
VITE_WS_URL=
# 高德地图 Web JS API Key；留空则所有地图降级为自绘示意图（功能可用，仅无底图）
VITE_AMAP_KEY=
# 高德 2021 年后申请的 Key 需配套安全密钥（用于 PlaceSearch 等服务）；可选
VITE_AMAP_SECURITY_CODE=
