# 复制为 .env 后按需修改。所有键带 ZY_ 前缀，真实环境变量优先于 .env。
ZY_ENV=dev
ZY_LOG_LEVEL=debug

ZY_HTTP_ADDR=:20080
ZY_HTTP_CORS_ORIGINS=http://localhost:20173,http://100.95.76.81:20173

ZY_DATABASE_URL=postgres://zhiyuche:zhiyuche@localhost:20432/zhiyuche?sslmode=disable
ZY_DATABASE_MAX_CONNS=10
ZY_DATABASE_AUTO_MIGRATE=true

ZY_REDIS_ADDR=localhost:20379
ZY_REDIS_PASSWORD=
ZY_REDIS_DB=0

ZY_JWT_SECRET=dev-only-secret
ZY_JWT_ACCESS_TTL=15m
ZY_JWT_REFRESH_TTL=168h

# 首次启动创建的平台超级管理员（仅当库中没有超级管理员时生效）
ZY_BOOTSTRAP_ADMIN_USERNAME=admin
ZY_BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
# 开发环境创建演示租户 chenhua（山东宸华）及其管理员 chenhua_admin
ZY_BOOTSTRAP_DEMO_TENANT=true
